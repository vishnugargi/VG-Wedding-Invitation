        else { clearInterval(fi); }
      }, 100);
      setTimeout(function () { musicBtn.classList.add('visible'); musicIcon.textContent = '🎵'; }, 600);
    }).catch(function (err) {
      console.warn('playMusic failed:', err);
      musicStarted = false;
      musicBtn.classList.add('visible');
      musicIcon.textContent = '🎵';
    });
  }

  function toggleMusic() {
    if (music.paused) {
      music.play().catch(function(){});
      musicPlaying = true;
      musicIcon.textContent = '🎵';
      if (music.volume === 0) music.volume = 0.6;
    } else {
      music.pause();
      musicPlaying = false;
      musicIcon.textContent = '🔇';
    }
  }

  // ── FLOATING PETALS ──
  (function() {
    var canvas = document.getElementById('petals-canvas');
    var ctx = canvas.getContext('2d');
    var petals = [];
    var COLORS = ['#c8a96e', '#e0c99a', '#f7f0e3', '#a0b89a', '#ffffff'];
    function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
    resize();
    window.addEventListener('resize', resize);
    function rand(a, b) { return a + Math.random() * (b - a); }
    function createPetal() {
      return { x: rand(0, canvas.width), y: rand(-20, -10), size: rand(4, 9), speed: rand(0.6, 1.6),
               drift: rand(-0.4, 0.4), rot: rand(0, Math.PI * 2), rotSpeed: rand(-0.02, 0.02),
               color: COLORS[Math.floor(Math.random() * COLORS.length)], opacity: rand(0.25, 0.7) };
    }
    for (var i = 0; i < 28; i++) { var p = createPetal(); p.y = rand(0, canvas.height); petals.push(p); }
    function drawPetal(p) {
      ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot);
      ctx.globalAlpha = p.opacity; ctx.fillStyle = p.color;
      ctx.beginPath(); ctx.ellipse(0, 0, p.size * .5, p.size, 0, 0, Math.PI * 2); ctx.fill(); ctx.restore();
    }
    function animate() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      petals.forEach(function(p, i) {
        drawPetal(p); p.y += p.speed; p.x += p.drift; p.rot += p.rotSpeed;
        if (p.y > canvas.height + 20) petals[i] = createPetal();
      });
      requestAnimationFrame(animate);
    }
    animate();
  })();

  // ── COUNTDOWN ──
  function updateCountdown() {
    var target = new Date('2026-09-30T09:00:00+05:30');
    var diff = target - new Date();
    if (diff <= 0) { ['cd-days','cd-hours','cd-mins','cd-secs'].forEach(function(id){ document.getElementById(id).textContent = '00'; }); return; }
    document.getElementById('cd-days').textContent  = String(Math.floor(diff / 86400000)).padStart(2,'0');
    document.getElementById('cd-hours').textContent = String(Math.floor((diff % 86400000) / 3600000)).padStart(2,'0');
    document.getElementById('cd-mins').textContent  = String(Math.floor((diff % 3600000) / 60000)).padStart(2,'0');
    document.getElementById('cd-secs').textContent  = String(Math.floor((diff % 60000) / 1000)).padStart(2,'0');
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);

  // ── SCROLL REVEAL ──
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(function(el) { observer.observe(el); });

  // ── FAQ ACCORDION ──
  function toggleFaq(btn) {
    var item = btn.closest('.faq-item');
    var isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(function(i) { i.classList.remove('open'); });
    if (!isOpen) item.classList.add('open');
  }

  // ── RSVP SUBMIT + EMAIL via Web3Forms ──
  var WEB3FORMS_KEY = '879438f6-5cff-4112-8f42-2153910f7b6b';
  var KAVANA_KEY = 'YOUR_KAVANA_KEY_HERE';

  function updateGuestNames() {
    var count = parseInt(document.getElementById('guestCount').value) || 1;
    var group = document.getElementById('guestNamesGroup');
    var container = document.getElementById('guestNameFields');
    if (count <= 1) { group.style.display = 'none'; return; }
    group.style.display = 'block';
    container.innerHTML = '';
    for (var i = 2; i <= count; i++) {
      var inp = document.createElement('input');
      inp.type = 'text';
      inp.className = 'form-control';
      inp.id = 'guest-' + i;
      inp.placeholder = 'Guest ' + (i - 1) + ' full name';
      inp.style.marginBottom = '0.5rem';
      container.appendChild(inp);
    }
  }

  async function submitRSVP() {
    var firstName = document.getElementById('firstName').value.trim();
    var lastName  = document.getElementById('lastName').value.trim();
    if (!firstName || !lastName) { alert('Please enter your name.'); return; }

    var attend  = (document.querySelector('input[name="attend"]:checked') || {}).value || 'Not specified';
    var weddingChecked   = document.getElementById('ev-wedding').checked;
    var receptionChecked = document.getElementById('ev-reception').checked;
    var events  = ['ev-wedding','ev-reception']
                    .filter(function(id){ return document.getElementById(id).checked; })
                    .map(function(id){ return id === 'ev-wedding' ? 'Wedding (Sep 30, Chikmagalur)' : 'Reception (Oct 02, Mangalore)'; })
                    .join(' & ') || 'None selected';
    var side    = document.getElementById('side').value || 'Not specified';
    var phone   = document.getElementById('phone').value.trim() || 'Not provided';
    var guestMessage = document.getElementById('message').value.trim() || '—';
    var guestCount = parseInt(document.getElementById('guestCount').value) || 1;
    var guestNames = [];
    for (var i = 2; i <= guestCount; i++) {
      var el = document.getElementById('guest-' + i);
      if (el && el.value.trim()) guestNames.push(el.value.trim());
    }

    var btn = document.querySelector('.form-submit');
    btn.textContent = 'Sending…';
    btn.disabled = true;

    var payload = {
      subject: 'RSVP — ' + firstName + ' ' + lastName + ' · Arun & Kavana Wedding',
      from_name: firstName + ' ' + lastName,
      name:    firstName + ' ' + lastName,
      phone: phone,
      attending: attend,
      events: events,
      side: side,
      "Guest Count": guestCount,
      "Guest Names": guestNames.length ? guestNames.join(', ') : '—',
      "Message to Couple": guestMessage,
    };

    try {
      var res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(Object.assign({ access_key: WEB3FORMS_KEY }, payload)),
      });
      var data = await res.json();
      if (!data.success) console.warn('Arun Web3Forms error:', data);
    } catch(e) { console.warn('Arun email failed:', e); }

    if (KAVANA_KEY !== 'YOUR_KAVANA_KEY_HERE') {
      try {
        await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(Object.assign({ access_key: KAVANA_KEY }, payload)),
        });
      } catch(e) { console.warn('Kavana email failed:', e); }
    }

    var noEventSelected = !weddingChecked && !receptionChecked;
    if (noEventSelected) {
      document.getElementById('formSuccessMsg').innerHTML = "Thanks for letting us know! We'll definitely miss having you there, but completely understand. Hope to catch up with you soon! 😊";
    } else {
      var seeYouMsg = (!weddingChecked && receptionChecked)
        ? 'See you on October 2nd!'
        : 'See you on September 30!';
      document.getElementById('seeYouMsg').textContent = seeYouMsg;
    }
    document.getElementById('formFields').style.display = 'none';
    document.getElementById('formSuccess').style.display = 'block';
  }

  // ++ ENVELOPE LONG PRESS ++
  (function () {
    var overlay    = document.getElementById('env-overlay');
    var seal       = document.getElementById('envSeal');
    var sealAnchor = document.getElementById('envSealAnchor');
    var flap       = document.getElementById('envFlap');
    var hint       = document.getElementById('envHint');
    var hintArea   = document.getElementById('envHintArea');
    var ringProg   = document.getElementById('sealRingProg');

    var HOLD_MS = 2000, CIRC = 301.59, DRIFT_PX = 16;
    var pressing = false, opened = false, rafId = null, startTime = null;
    var startX = 0, startY = 0;

    var _scrollY = 0;
    function lockScroll() {
      _scrollY = window.scrollY || window.pageYOffset;
      document.body.style.position = 'fixed';
      document.body.style.top = '-' + _scrollY + 'px';
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
    }
    function unlockScroll() {
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      window.scrollTo(0, _scrollY);
    }
    lockScroll();

    function startPress(e) {
      if (opened || pressing) return;
      e.preventDefault();
      pressing = true;
      startX = e.clientX; startY = e.clientY;
      startTime = performance.now();
      seal.classList.add('pressing');
      hint.textContent = 'Keep holding…';

      function tick(now) {
        if (!pressing) return;
        var p = Math.min((now - startTime) / HOLD_MS, 1);
        ringProg.style.strokeDashoffset = CIRC * (1 - p);
        if (p >= 1) { triggerBreak(); return; }
        rafId = requestAnimationFrame(tick);
      }
      rafId = requestAnimationFrame(tick);
    }

    function cancelPress() {
      if (!pressing) return;
      pressing = false;
      seal.classList.remove('pressing');
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
      ringProg.style.transition = 'stroke-dashoffset 0.5s ease';
      ringProg.style.strokeDashoffset = CIRC;
      setTimeout(function(){ ringProg.style.transition = ''; }, 500);
      hint.textContent = 'Hold to open';
    }

    function onMove(e) {
      if (!pressing) return;
      var dx = e.clientX - startX, dy = e.clientY - startY;
      if (Math.sqrt(dx * dx + dy * dy) > DRIFT_PX) cancelPress();
    }

    function triggerBreak() {
      pressing = false; opened = true;
      seal.classList.remove('pressing');
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
      if (navigator.vibrate) navigator.vibrate([20, 30, 60]);
      seal.classList.add('breaking');
      hint.textContent = '';

      // 🎵 Music will be started from pointerup/touchend (genuine gesture context).
      // For desktop (mouse), call it here directly — no autoplay restriction on desktop.
      if (!('ontouchstart' in window)) playMusic();

      setTimeout(function () {
        flap.classList.add('open');
        sealAnchor.classList.add('seal-dropped');
        hintArea.style.opacity = '0';
      }, 560);

      setTimeout(function () {
        var card = document.getElementById('envCard');
        if (card) card.classList.add('peek');
      }, 950);

      setTimeout(function () {
        var f = document.getElementById('envFlap');
        if (f) f.style.display = 'none';
      }, 1450);

      setTimeout(function () {
        overlay.classList.add('env-done');
        unlockScroll();
      }, 3800);

      setTimeout(function () {
        if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
      }, 5100);
    }

    seal.addEventListener('touchstart', function(e) {
      e.preventDefault();
    }, { passive: false });
    seal.addEventListener('pointerdown',   startPress,  { passive: false });
    seal.addEventListener('pointermove',   onMove,      { passive: true });
    seal.addEventListener('pointerup', function (e) {
      // If the envelope was successfully opened, start music now —
      // pointerup IS a genuine user-gesture context on all mobile browsers.
      if (opened) { playMusic(); return; }
      cancelPress();
    });
    seal.addEventListener('touchend', function () {
      // touchend backup for browsers that fire touch but not pointer events
      if (opened) playMusic();
    }, { passive: true });
    seal.addEventListener('pointercancel', cancelPress);
    seal.addEventListener('contextmenu',   function(e){ e.preventDefault(); });
  })();
</script>


