<!DOCTYPE html>
<!-- saved from url=(0046)https://arunsalian.github.io/Arun-Kavana-2026/ -->
<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Arun &amp; Kavana — September 30, 2026</title>
  <link href="./Arun &amp; Kavana — September 30, 2026_files/css2" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --forest: #2b3b2c;
      --forest-light: #3d5440;
      --forest-dark: #1a2519;
      --gold: #c8a96e;
      --gold-light: #e0c99a;
      --gold-pale: #f7f0e3;
      --cream: #faf6f0;
      --white: #ffffff;
      --text: #2c2c2c;
      --text-muted: #6b6b6b;
      --serif: 'Cormorant Garamond', Georgia, serif;
      --script: 'Great Vibes', cursive;
      --sans: 'Montserrat', sans-serif;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--serif);
      background: var(--cream);
      color: var(--text);
      overflow-x: hidden;
    }

    /* ── MUSIC TOGGLE BUTTON ── */
    #musicBtn {
      position: fixed;
      bottom: 1.6rem;
      right: 1.6rem;
      z-index: 8888;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--forest);
      border: 1.5px solid var(--gold);
      color: var(--gold);
      font-size: 1.2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(0,0,0,.35);
      opacity: 0;
      pointer-events: none;
      transition: opacity .6s ease, transform .25s ease, background .25s;
    }
    #musicBtn.visible { opacity: 1; pointer-events: auto; }
    #musicBtn:hover { background: var(--forest-light); transform: scale(1.08); }
    #musicBtn .music-icon { line-height: 1; }

    /* ── HERO ── */
    #hero {
      position: relative;
      height: 100svh;
      min-height: 600px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      text-align: center;
    }
    .hero-bg {
      position: fixed;
      inset: 0;
      background: url('https://theweddinglink.s3.ap-south-1.amazonaws.com/sites/5be667e0-5973-4433-b714-13e808d4ac21/2026-08_hero.jpg') center/cover no-repeat;
      filter: brightness(.45);
      z-index: -1;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(27,37,25,.3) 0%, rgba(27,37,25,.15) 50%, rgba(27,37,25,.75) 100%);
    }
    #petals-canvas {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    .hero-content {
      position: relative;
      z-index: 2;
      padding: 0 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .9rem;
    }
    /* ── TOP SCRIPTURE BANNER ── */
    .scripture-banner {
      width: 100%;
      background: var(--forest-dark);
      text-align: center;
      padding: .9rem 1.5rem;
      border-bottom: 1px solid rgba(200,169,110,.25);
    }
    .scripture-banner p {
      font-family: var(--serif);
      font-style: italic;
      font-size: clamp(.8rem, 1.6vw, .95rem);
      font-weight: 300;
      color: rgba(255,255,255,.78);
      letter-spacing: .04em;
      line-height: 1.5;
    }
    .scripture-banner cite {
      font-family: var(--sans);
      font-style: normal;
      font-size: .65rem;
      letter-spacing: .22em;
      color: var(--gold);
      text-transform: uppercase;
      display: block;
      margin-top: .35rem;
      text-align: center;
    }
    .hero-tag {
      font-family: var(--sans);
      font-size: .68rem;
      letter-spacing: .28em;
      text-transform: uppercase;
      color: var(--gold);
      opacity: 0;
      animation: fadeUp .8s .35s forwards;
    }
    .hero-divider {
      width: 60px;
      height: 1px;
      background: var(--gold);
      opacity: 0;
      animation: fadeUp .8s .5s forwards;
    }
    .couple-name {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(2.6rem, 9vw, 7rem);
      font-weight: 300;
      color: var(--white);
      line-height: 1;
      letter-spacing: .06em;
      opacity: 0;
      animation: fadeUp 1s .5s forwards;
      white-space: nowrap;
    }
    .couple-name .name-line { display: inline; }
    .couple-name .name-and {
      font-family: var(--script);
      font-size: .5em;
      letter-spacing: .1em;
      color: var(--gold);
      vertical-align: middle;
      margin: 0 .2em;
    }
    .hero-date {
      display: flex;
      align-items: baseline;
      gap: .6rem;
      opacity: 0;
      animation: fadeUp .8s .85s forwards;
    }
    .hero-date-month,
    .hero-date-day,
    .hero-date-year {
      font-family: var(--sans);
      font-size: clamp(.85rem, 2vw, 1.05rem);
      font-weight: 400;
      letter-spacing: .26em;
      text-transform: uppercase;
      color: var(--gold-light);
      line-height: 1;
    }
    .hero-date-dot {
      font-size: .5em;
      color: var(--gold);
      vertical-align: middle;
      opacity: .7;
    }
    .hero-location {
      font-family: var(--sans);
      font-size: .78rem;
      letter-spacing: .14em;
      color: rgba(255,255,255,.75);
      opacity: 0;
      animation: fadeUp .8s 1.05s forwards;
    }
    .hero-scroll {
      position: absolute;
      bottom: 2.2rem;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .5rem;
      opacity: 0;
      animation: fadeIn 1s 1.6s forwards;
    }
    .hero-scroll span {
      font-family: var(--sans);
      font-size: .62rem;
      letter-spacing: .2em;
      color: rgba(255,255,255,.55);
      text-transform: uppercase;
    }
    .scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(to bottom, rgba(200,169,110,.8), transparent);
      animation: scrollPulse 2s 2s infinite;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    @keyframes scrollPulse {
      0%, 100% { opacity: .6; transform: scaleY(1); }
      50%       { opacity: 1; transform: scaleY(1.15); }
    }

    /* ── SECTIONS ── */
    section { padding: 6rem 1.5rem; }
    .section-inner { max-width: 860px; margin: 0 auto; }
    .section-tag {
      font-family: var(--sans);
      font-size: .65rem;
      letter-spacing: .3em;
      text-transform: uppercase;
      color: var(--gold);
      display: block;
      text-align: center;
      margin-bottom: .75rem;
    }
    .section-title {
      font-family: var(--script);
      font-size: clamp(2.4rem, 6vw, 3.8rem);
      color: var(--forest);
      text-align: center;
      line-height: 1.1;
      margin-bottom: 1.2rem;
    }
    .section-rule {
      display: flex;
      align-items: center;
      gap: 1rem;
      justify-content: center;
      margin-bottom: 2.8rem;
    }
    .section-rule::before,
    .section-rule::after {
      content: '';
      flex: 1;
      max-width: 100px;
      height: 1px;
      background: var(--gold);
      opacity: .5;
    }
    .section-rule-icon { color: var(--gold); font-size: 1rem; }

    /* ── COUNTDOWN ── */
    #countdown { background: var(--forest); }
    #countdown .section-title { color: var(--gold-light); }
    #countdown .section-tag  { color: var(--gold); }
    .countdown-grid {
      display: flex;
      gap: 1.5rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .countdown-unit {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .4rem;
      min-width: 90px;
    }
    .countdown-num {
      font-family: var(--serif);
      font-size: clamp(2.8rem, 8vw, 5rem);
      font-weight: 300;
      color: var(--white);
      line-height: 1;
      min-width: 2ch;
      text-align: center;
    }
    .countdown-label {
      font-family: var(--sans);
      font-size: .62rem;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--gold);
    }
    .countdown-sep {
      font-size: clamp(2.5rem, 7vw, 4.5rem);
      color: var(--gold);
      opacity: .4;
      line-height: 1;
      margin-top: -.2rem;
    }

    /* ── EVENTS ── */
    #events { background: var(--cream); }
    .events-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
    }
    .event-card {
      background: var(--white);
      border-radius: 2px;
      overflow: hidden;
      box-shadow: 0 4px 32px rgba(43,59,44,.08);
      transition: transform .3s, box-shadow .3s;
      display: flex;
      flex-direction: column;
    }
    .event-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 48px rgba(43,59,44,.14);
    }
    .event-card-header {
      background: var(--forest);
      padding: 1.8rem 2rem 1.4rem;
    }
    .event-card-type {
      font-family: var(--sans);
      font-size: .65rem;
      letter-spacing: .25em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: .5rem;
    }
    .event-card-name {
      font-family: var(--script);
      font-size: 2rem;
      color: var(--white);
      line-height: 1;
    }
    .event-card-body {
      padding: 1.8rem 2rem;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .event-detail {
      display: flex;
      align-items: flex-start;
      gap: .75rem;
    }
    .event-icon {
      width: 18px;
      text-align: center;
      color: var(--gold);
      font-size: 1rem;
      flex-shrink: 0;
      margin-top: .1rem;
    }
    .event-detail-text {
      font-family: var(--sans);
      font-size: .82rem;
      line-height: 1.5;
      color: var(--text-muted);
    }
    .event-detail-text strong { color: var(--text); font-weight: 500; }
    .event-card-actions {
      padding: 0 2rem 1.8rem;
      display: flex;
      gap: .75rem;
    }
    .btn {
      font-family: var(--sans);
      font-size: .72rem;
      font-weight: 500;
      letter-spacing: .1em;
      text-transform: uppercase;
      padding: .7rem 1.3rem;
      border-radius: 2px;
      text-decoration: none;
      transition: all .25s;
      cursor: pointer;
      border: none;
      display: inline-block;
    }
    .btn-primary { background: var(--forest); color: var(--white); }
    .btn-primary:hover { background: var(--forest-light); }
    .btn-outline {
      background: transparent;
      color: var(--forest);
      border: 1.5px solid var(--forest);
    }
    .btn-outline:hover { background: var(--forest); color: var(--white); }
    .btn-gold { background: var(--gold); color: var(--forest-dark); }
    .btn-gold:hover { background: var(--gold-light); }

    /* ── RSVP ── */
    #rsvp { background: var(--forest); }
    #rsvp .section-title { color: var(--gold-light); }
    #rsvp .section-tag  { color: var(--gold); }
    #rsvp .section-rule::before,
    #rsvp .section-rule::after { background: rgba(200,169,110,.4); }
    .rsvp-form {
      background: var(--white);
      border-radius: 2px;
      padding: 3rem 3rem 2.5rem;
      max-width: 580px;
      margin: 0 auto;
      box-shadow: 0 24px 80px rgba(0,0,0,.25);
    }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: .4rem;
      margin-bottom: 1.4rem;
    }
    .form-label {
      font-family: var(--sans);
      font-size: .68rem;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--forest);
      font-weight: 700;
    }
    .form-control {
      font-family: var(--sans);
      font-size: .9rem;
      font-weight: 600;
      color: var(--text);
      background: var(--cream);
      border: 1.5px solid transparent;
      border-radius: 2px;
      padding: .75rem 1rem;
      outline: none;
      transition: border-color .25s, background .25s;
      width: 100%;
    }
    .form-control:focus { border-color: var(--gold); background: var(--white); }
    .form-control::placeholder { color: #bbb; }
    select.form-control { appearance: none; cursor: pointer; }
    textarea.form-control { resize: vertical; min-height: 100px; }
    .attend-options { display: flex; gap: .75rem; flex-wrap: wrap; }
    .attend-opt { flex: 1; min-width: 90px; }
    .attend-opt input { display: none; }
    .attend-opt label {
      display: block;
      padding: .7rem .5rem;
      background: var(--cream);
      border: 1.5px solid transparent;
      border-radius: 2px;
      text-align: center;
      font-family: var(--sans);
      font-size: .72rem;
      font-weight: 600;
      letter-spacing: .08em;
      cursor: pointer;
      transition: all .25s;
      color: var(--text-muted);
    }
    .attend-opt input:checked + label {
      border-color: var(--forest);
      background: var(--forest);
      color: var(--white);
    }
    .checkbox-group { display: flex; flex-direction: column; gap: .6rem; }
    .check-item {
      display: flex;
      align-items: center;
      gap: .7rem;
      cursor: pointer;
      font-family: var(--sans);
      font-size: .82rem;
      font-weight: 600;
      color: var(--text-muted);
    }
    .check-item input[type="checkbox"] {
      width: 16px;
      height: 16px;
      accent-color: var(--forest);
      cursor: pointer;
    }
    .form-submit {
      width: 100%;
      padding: 1rem;
      margin-top: .5rem;
      font-size: .8rem;
      letter-spacing: .18em;
    }
    .form-success {
      display: none;
      text-align: center;
      padding: 2.5rem 1rem;
    }
    .form-success-icon { font-size: 3rem; display: block; margin-bottom: 1rem; }
    .form-success h3 {
      font-family: var(--script);
      font-size: 2.2rem;
      color: var(--forest);
      margin-bottom: .5rem;
    }
    .form-success p { font-size: 1rem; font-style: italic; color: var(--text-muted); }

    @media(max-width: 560px) {
      .rsvp-form { padding: 2rem 1.5rem; }
      .form-row { grid-template-columns: 1fr; }
    }

    /* ── FAQ ── */
    #faq { background: var(--white); }
    .faq-list {
      max-width: 640px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: .75rem;
    }
    .faq-item {
      border: 1.5px solid rgba(200,169,110,.35);
      border-radius: 2px;
      overflow: hidden;
    }
    .faq-q {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.1rem 1.5rem;
      background: var(--cream);
      border: none;
      cursor: pointer;
      font-family: var(--serif);
      font-size: 1.05rem;
      font-weight: 500;
      color: var(--forest);
      text-align: left;
      gap: 1rem;
    }
    .faq-q:hover { background: var(--gold-pale); }
    .faq-arrow { color: var(--gold); font-size: 1rem; flex-shrink: 0; transition: transform .3s; }
    .faq-item.open .faq-arrow { transform: rotate(180deg); }
    .faq-a {
      max-height: 0;
      overflow: hidden;
      transition: max-height .4s ease;
      font-size: 1rem;
      font-style: italic;
      color: var(--text-muted);
      line-height: 1.7;
    }
    .faq-item.open .faq-a { max-height: 200px; }
    .faq-a-inner { padding: 1rem 1.5rem 1.2rem; }

    /* ── FOOTER ── */
    footer {
      background: var(--forest-dark);
      text-align: center;
      padding: 4rem 1.5rem 2.5rem;
    }
    .footer-title {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(2.4rem, 7vw, 3.5rem);
      font-weight: 300;
      letter-spacing: .08em;
      color: var(--gold-light);
      margin-bottom: .5rem;
    }
    .footer-date {
      font-family: var(--sans);
      font-size: .7rem;
      letter-spacing: .22em;
      color: rgba(255,255,255,.45);
      text-transform: uppercase;
      margin-bottom: 2rem;
    }
    .footer-divider {
      width: 40px;
      height: 1px;
      background: var(--gold);
      margin: 0 auto 1.5rem;
      opacity: .4;
    }
    .footer-links {
      display: flex;
      gap: 2rem;
      justify-content: center;
      list-style: none;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .footer-links a {
      font-family: var(--sans);
      font-size: .65rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: rgba(255,255,255,.45);
      text-decoration: none;
      transition: color .25s;
    }
    .footer-links a:hover { color: var(--gold); }
    .footer-credit { font-family: var(--sans); font-size: .65rem; letter-spacing: .1em; color: rgba(255,255,255,.2); }

    /* ── RESPONSIVE — TABLET (≤768px) ── */
    @media (max-width: 768px) {
      section { padding: 4rem 1.2rem; }
      #hero { min-height: 100svh; }
      .hero-content { gap: .75rem; padding: 0 1rem; }
      .hero-tag { font-size: .62rem; letter-spacing: .22em; }
      .couple-name { font-size: clamp(2.4rem, 11vw, 5rem); }
      .hero-date { gap: .45rem; flex-wrap: wrap; justify-content: center; }
      .hero-date-month, .hero-date-day, .hero-date-year { font-size: .82rem; letter-spacing: .2em; }
      .hero-location { font-size: .72rem; }
      .section-title { font-size: clamp(2rem, 7vw, 3rem); }
      .countdown-grid { gap: 1rem; }
      .countdown-unit { min-width: 70px; }
      .countdown-num { font-size: clamp(2.4rem, 9vw, 4rem); }
      .countdown-sep { font-size: clamp(2rem, 7vw, 3.5rem); }
      .events-grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; }
      .event-card:hover { transform: none; }
      .btn { padding: .85rem 1.4rem; font-size: .75rem; min-height: 44px; }
      .event-card-actions { gap: .6rem; }
      .rsvp-form { padding: 2rem 1.2rem; }
      .form-row { grid-template-columns: 1fr; gap: 0; }
      .form-control { font-size: .95rem; padding: .85rem 1rem; min-height: 48px; }
      .attend-opt label { padding: .85rem .4rem; min-height: 48px; display: flex; align-items: center; justify-content: center; }
      .check-item { font-size: .88rem; padding: .3rem 0; }
      .check-item input[type="checkbox"] { width: 20px; height: 20px; }
      .form-submit { padding: 1.1rem; font-size: .82rem; min-height: 52px; }
      .faq-q { font-size: .98rem; padding: 1rem 1.2rem; min-height: 52px; }
      .faq-a-inner { padding: .9rem 1.2rem 1rem; font-size: .95rem; }
      .footer-links { gap: 1.2rem; }
    }

    /* ── RESPONSIVE — MOBILE (≤480px) ── */
    @media (max-width: 480px) {
      section { padding: 3.5rem 1rem; }
      .scripture-banner { padding: .75rem 1rem; }
      .scripture-banner p { font-size: .78rem; line-height: 1.6; }
      #hero { min-height: 100svh; }
      .hero-content { gap: .65rem; }
      .couple-name {
        font-size: clamp(2rem, 12vw, 3.5rem);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
      }
      .hero-date { gap: .35rem; }
      .hero-date-month, .hero-date-day, .hero-date-year { font-size: .72rem; letter-spacing: .16em; }
      .hero-date-dot { font-size: .4em; }
      .hero-location { font-size: .68rem; letter-spacing: .1em; }
      .hero-scroll { bottom: 1.5rem; }
      .countdown-sep { display: none; }
      .countdown-grid { gap: .5rem 1.8rem; }
      .countdown-unit { min-width: 60px; }
      .countdown-num { font-size: clamp(2.2rem, 11vw, 3.5rem); }
      .countdown-label { font-size: .58rem; }
      .section-title { font-size: clamp(1.9rem, 8vw, 2.6rem); }
      .section-tag { font-size: .6rem; letter-spacing: .22em; }
      .event-card-header { padding: 1.4rem 1.4rem 1rem; }
      .event-card-name { font-size: 1.7rem; }
      .event-card-body { padding: 1.4rem; gap: .8rem; }
      .event-card-actions { padding: 0 1.4rem 1.4rem; flex-direction: column; }
      .btn { width: 100%; text-align: center; justify-content: center; }
      #greeting { padding: 3rem 1.2rem !important; }
      .rsvp-form { padding: 1.8rem 1rem; border-radius: 4px; }
      .attend-options { flex-direction: column; }
      .attend-opt { min-width: 100%; }
      .faq-q { font-size: .92rem; }
      .footer-title { font-size: clamp(1.8rem, 8vw, 2.8rem); }
      .footer-links { gap: 1rem; }
      footer { padding: 3rem 1rem 2rem; }
      #musicBtn { bottom: 1rem; right: 1rem; width: 44px; height: 44px; font-size: 1.1rem; }
    }

    /* ── ENVELOPE OVERLAY ── */
    #env-overlay {
      position: fixed; inset: 0;
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
